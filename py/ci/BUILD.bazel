load("//bzl:rules.bzl", "bazel_lint")
load("//py:rules.bzl", "py_binary", "py_library", "py_test")

exports_files(
    ["find_deploy_bundle.py"],
    visibility = ["//ci/workflows:__pkg__"],
)

py_library(
    name = "ci",
    srcs = [
        "__init__.py",
        "find_deploy_bundle.py",
        "verify_staging_candidate.py",
    ],
    visibility = ["//:__subpackages__"],
)

py_test(
    name = "find_deploy_bundle_test",
    size = "small",
    srcs = ["find_deploy_bundle_test.py"],
    deps = [":ci"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

py_binary(
    name = "find_deploy_bundle",
    srcs = ["find_deploy_bundle.py"],
    visibility = ["//:__subpackages__"],
)

py_binary(
    name = "verify_staging_candidate",
    srcs = ["verify_staging_candidate.py"],
    visibility = ["//:__subpackages__"],
    deps = [":ci"],
)

py_test(
    name = "verify_staging_candidate_test",
    size = "small",
    srcs = ["verify_staging_candidate_test.py"],
    deps = [":ci"],
)
