load("//bzl:rules.bzl", "bazel_lint")
load("//py:rules.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "ci",
    srcs = [
        "__init__.py",
        "find_staging_bundle.py",
    ],
    visibility = ["//:__subpackages__"],
)

py_test(
    name = "find_staging_bundle_test",
    size = "small",
    srcs = ["find_staging_bundle_test.py"],
    deps = [":ci"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

py_binary(
    name = "find_staging_bundle",
    srcs = ["find_staging_bundle.py"],
    visibility = ["//:__subpackages__"],
)
