# gazelle:resolve py py.ci.renovate_bcr.registry_pb2 //py/ci/renovate_bcr:registry_py_proto
# gazelle:resolve py py.ci.renovate_bcr.feed //py/ci/renovate_bcr
load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@com_google_protobuf//bazel:py_proto_library.bzl", "py_proto_library")
load("//bzl:rules.bzl", "bazel_lint")
load("//py:rules.bzl", "py_binary", "py_library", "py_test")

proto_library(
    name = "registry_proto",
    srcs = ["registry.proto"],
    visibility = ["//visibility:public"],
)

py_proto_library(
    name = "registry_py_proto",
    deps = [":registry_proto"],
)

py_library(
    name = "renovate_bcr",
    srcs = ["feed.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//py/ci/renovate_bcr:registry_py_proto"],
)

py_test(
    name = "feed_test",
    size = "small",
    srcs = ["feed_test.py"],
    deps = [
        "//py/ci/renovate_bcr",
        "//py/ci/renovate_bcr:registry_py_proto",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

py_binary(
    name = "feed",
    srcs = ["feed.py"],
    visibility = ["//:__subpackages__"],
    deps = ["//py/ci/renovate_bcr:registry_py_proto"],
)
