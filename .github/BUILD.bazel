load("@npm//:renovate/package_json.bzl", "bin")
load("//bzl:rules.bzl", "bazel_lint")
load("//js:rules.bzl", "js_library", "js_test")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "ts_project")
load("//yml:test.bzl", "yaml_lint_test")

exports_files(["renovate-global.json"])

ts_project(
    name = ".github",
    srcs = ["renovate_provider_test.ts"],
    extends = "//:tsconfig",
    tsconfig = {},
    visibility = ["//:__subpackages__"],
    deps = ["//:node_modules/renovate"],  # keep: dynamic Renovate imports
)

js_test(
    name = "renovate_provider_test",
    data = [
        "renovate-global.json",
        ":.github",
        "//:package_json",
        "//:renovate_bazel_inputs",
    ],
    entry_point = "renovate_provider_test.js",
    node_toolchain = select({
        "@bazel_tools//src/conditions:darwin_arm64": "@renovate_test_node_darwin_arm64//:toolchain",
        "@bazel_tools//src/conditions:darwin_x86_64": "@renovate_test_node_darwin_amd64//:toolchain",
        "@bazel_tools//src/conditions:linux_aarch64": "@renovate_test_node_linux_arm64//:toolchain",
        "@bazel_tools//src/conditions:linux_x86_64": "@renovate_test_node_linux_amd64//:toolchain",
        "@bazel_tools//src/conditions:windows_arm64": "@renovate_test_node_windows_arm64//:toolchain",
        "@bazel_tools//src/conditions:windows_x64": "@renovate_test_node_windows_amd64//:toolchain",
    }),
)

js_test(
    name = "renovate_bazel_releases_test",
    size = "small",
    data = [
        "renovate-global.json",
        "//:node_modules/renovate",
        "//:renovate_bazel_inputs",
    ],
    entry_point = "renovate_bazel_releases_test.mjs",
)

js_library(
    name = "renovate_bazel_releases_test_mjs",
    srcs = ["renovate_bazel_releases_test.mjs"],
    deps = ["//:node_modules/renovate"],
)

js_test(
    name = "renovate_pnpm_test",
    size = "small",
    data = [
        ":renovate_pnpm_test_mjs",
        "//:package_json",
        "@pnpm",
    ],
    entry_point = "renovate_pnpm_test.mjs",
    env = {
        "PACKAGE_JSON": "$(rlocationpath //:package_json)",
        "PNPM_BIN": "$(rlocationpath @pnpm//:pnpm)",
    },
)

js_library(
    name = "renovate_pnpm_test_mjs",
    srcs = ["renovate_pnpm_test.mjs"],
    deps = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/renovate",
    ],
)

js_test(
    name = "renovate_python_lock_test",
    data = [
        "renovate-global.json",
        "//:node_modules/renovate",
        "//:renovate_python_inputs",
        "//py/mitmproxy:renovate_python_inputs",
    ],
    entry_point = "renovate_python_lock_test.mjs",
)

bin.renovate_config_validator_test(
    name = "validate_renovate_config_test",
    args = [
        "$(location renovate-global.json)",
        "--strict",
    ],
    data = ["renovate-global.json"],
)

yaml_lint_test(
    name = "validation",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

md_files(
    name = "github",
    srcs = ["AGENTS.md"],
    visibility = ["//:__subpackages__"],
)

js_library(
    name = "renovate_python_lock_test_mjs",
    srcs = ["renovate_python_lock_test.mjs"],
    deps = ["//:node_modules/renovate"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = ["renovate_provider_test.ts"],
    visibility = ["//:__subpackages__"],
)
