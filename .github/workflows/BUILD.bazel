load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//md:rules.bzl", "md_files")
load("//yml:test.bzl", "yaml_lint_test")

exports_files(["presubmit.yml"])

filegroup(
    name = "workflow_test_files",
    srcs = glob(
        [
            "*.yaml",
            "*.yml",
        ],
        allow_empty = True,
    ) + [
        "bootstrap_bazel_remote_cache.sh",
        "prepare_ci.sh",
        "//.github:actions/build-deploy-bundle/action.yml",
        "//.github:actions/build-deploy-bundle/build.sh",
        "//.github:actions/upload-deploy-bundle/action.yml",
    ],
    visibility = ["//ci/workflows:__pkg__"],
)

yaml_lint_test(
    name = "validation",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

md_files(
    name = "github_workflows",
    srcs = ["README.md"],
    visibility = ["//:__subpackages__"],
)

test_suite(
    name = "workflow_behavior_tests",
    tests = ["//ci/workflows:workflows_test"],
)

sh_test(
    name = "actionlint_test",
    size = "small",
    srcs = ["actionlint_test.sh"],
    args = ["$(rootpath %s)" % path for path in glob(
        [
            "*.yml",
            "*.yaml",
        ],
        allow_empty = True,
    )],
    data = glob(
        [
            "*.yml",
            "*.yaml",
        ],
        allow_empty = True,
    ) + [
        "//.github:actions/build-deploy-bundle/action.yml",
        "//.github:actions/upload-deploy-bundle/action.yml",
        "@com_github_rhysd_actionlint//cmd/actionlint",
    ],
    env = {
        "ACTIONLINT": "$(rlocationpath @com_github_rhysd_actionlint//cmd/actionlint)",
    },
    deps = ["@rules_shell//shell/runfiles"],
)
