load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//js:rules.bzl", "js_binary")
load("//ts:rules.bzl", "ts_project")

ts_project(
    name = "production",
    srcs = ["production.ts"],
    visibility = ["//ci:__pkg__"],
    deps = [
        "//ts/github/actions",
        "//ts/pulumi",
    ],
)

ts_project(
    name = "deploy_lib",
    srcs = [
        "deploy.ts",
        "verify.ts",
    ],
    deps = [
        ":production",
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@types/node",
        "//ts/pulumi",
        "//ts/pulumi:cli",
    ],
)

js_binary(
    name = "deploy",
    data = [
        ":deploy_lib",
        "//VERSION",
        "//bin/linux/pulumi:providers",
        "//bzl/pulumi_providers:checkpoint_versions",
    ],
    entry_point = "deploy.js",
    env = {
        "PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION": "true",
        "PULUMI_IGNORE_AMBIENT_PLUGINS": "true",
    },
)

sh_test(
    name = "providers_test",
    size = "medium",
    srcs = ["providers_test.sh"],
    args = ["$(rootpath :deploy)"],
    data = [":deploy"],
)

sh_test(
    name = "deploy_failure_test",
    size = "medium",
    srcs = ["deploy_failure_test.sh"],
    args = ["$(rootpath :deploy)"],
    data = [":deploy"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "deploy.ts",
        "production.ts",
        "verify.ts",
    ],
    visibility = ["//:__subpackages__"],
)
