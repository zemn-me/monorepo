load("@aspect_rules_js//js:defs.bzl", "js_image_layer")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//js:rules.bzl", "js_binary")
load("//ts:rules.bzl", "ts_project")

ts_project(
    name = "production",
    srcs = ["production.ts"],
    visibility = ["//ci:__pkg__"],
    deps = [
        "//ts/github/actions",
        "//ts/pulumi",
    ],
)

ts_project(
    name = "deploy_lib",
    srcs = [
        "deploy.ts",
        "verify.ts",
    ],
    deps = [
        ":production",
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@types/node",
        "//ts/pulumi",
        "//ts/pulumi:cli",
    ],
)

js_binary(
    name = "deploy",
    data = [
        ":deploy_lib",
        "//VERSION",
        "//bin/linux/pulumi:providers",
    ],
    entry_point = "deploy.js",
    env = {
        "PULUMI_DISABLE_AUTOMATIC_PLUGIN_ACQUISITION": "true",
        "PULUMI_IGNORE_AMBIENT_PLUGINS": "true",
    },
)

# Keep the launcher, its Node runtime, pnpm links and Pulumi assets together.
js_image_layer(
    name = "layers",
    binary = ":deploy",
    layer_groups = {"bundle": ""},
    tags = ["manual"],
)

filegroup(
    name = "bundle",
    srcs = [":layers"],
    output_group = "bundle",
    tags = ["manual"],
)

sh_test(
    name = "bundle_test",
    size = "medium",
    srcs = ["bundle_test.sh"],
    args = [
        "$(rootpath run.sh)",
        "$(rootpath :bundle)",
    ],
    data = [
        "run.sh",
        ":bundle",
    ],
    tags = ["manual"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "deploy.ts",
        "production.ts",
        "verify.ts",
    ],
    visibility = ["//:__subpackages__"],
)
