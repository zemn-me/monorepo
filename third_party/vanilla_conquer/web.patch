+#ifdef __EMSCRIPTEN__
+    // Native 320x200 mode keeps battlefield sprites at their original pixel
+    // size, showing less terrain instead of shrinking the army on a phone.
+    // Recompute on every launch so a saved phone setting cannot affect desktop.
