        "common/settings.cpp",
        "common/sha.cpp",
        "common/shape.cpp",
        "common/shapipe.cpp",
        "common/shastraw.cpp",
        "common/soscodec.cpp",
        "common/stamp.cpp",
        "common/straw.cpp",
        "common/timer.cpp",
        "common/timerdwn.cpp",
        "common/tobuff.cpp",
        "common/toggle.cpp",
        "common/vector.cpp",
        "common/winasm.cpp",
        "common/windows.cpp",
        "common/winhide.cpp",
        "common/winstub.cpp",
        "common/wsa.cpp",
        "common/xordelta.cpp",
        "common/xpipe.cpp",
        "common/xstraw.cpp",
