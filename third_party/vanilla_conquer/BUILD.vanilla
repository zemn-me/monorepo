    ],
    hdrs = glob(["common/*.h"]),
    copts = [
        "-std=c++11",
        "-fsigned-char",
    ],
    defines = [
        "ENGLISH",
        "TRUE_FALSE_DEFINED",
        "FIXIT_FAST_LOAD",
    ],
    includes = ["common"],
)

cc_binary(
    name = "vanillamix",
    srcs = glob([
        "tools/mixtool/*.cpp",
        "tools/mixtool/*.h",
    ]),
    copts = [
        "-std=c++11",
        "-fsigned-char",
    ],
    deps = [":common"],
)
