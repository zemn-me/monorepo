        "common/ccfile.cpp",
        "common/cdfile.cpp",
        "common/cliprect.cpp",
        "common/combuf.cpp",
        "common/control.cpp",
        "common/crc.cpp",
        "common/crew.cpp",
        "common/cstraw.cpp",
        "common/debugstring.cpp",
        "common/delay.cpp",
        "common/dipthong.cpp",
        "common/drawbuff.cpp",
        "common/drawline.cpp",
        "common/drawmisc.cpp",
        "common/face.cpp",
        "common/fading.cpp",
        "common/field.cpp",
        "common/file.cpp",
        "common/file_posix.cpp",
        "common/filepcx.cpp",
        "common/fixed.cpp",
        "common/font.cpp",
        "common/gadget.cpp",
        "common/getshape.cpp",
        "common/graphicsviewport.cpp",
        "common/hsv.cpp",
        "common/iff.cpp",
        "common/ini.cpp",
        "common/int.cpp",
        "common/internet.cpp",
        "common/irandom.cpp",
        "common/keybuff.cpp",
        "common/keyframe.cpp",
        "common/lcw.cpp",
        "common/lcwpipe.cpp",
        "common/lcwstraw.cpp",
        "common/linear.cpp",
        "common/link.cpp",
        "common/load.cpp",
        "common/memrev.cpp",
        "common/misc.cpp",
        "common/mixfile.cpp",
        "common/mp.cpp",
        "common/newdel.cpp",
        "common/packet.cpp",
        "common/palette.cpp",
        "common/palettec.cpp",
        "common/paths.cpp",
        "common/paths_posix.cpp",
        "common/pipe.cpp",
        "common/pk.cpp",
        "common/pkpipe.cpp",
        "common/pkstraw.cpp",
