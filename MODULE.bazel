bindeps = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
bindeps.spec(
    artifact = "bin",
    package = "ripgrep",
    version = "=15.1.0",
)
bindeps.annotation(
    crate = "ripgrep",
    gen_all_binaries = True,
)
bindeps.from_specs(
    name = "bindeps",
    host_tools = "@rust_host_tools_nightly",
)
use_repo(bindeps, "bindeps")

