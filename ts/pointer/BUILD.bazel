load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "pointer",
    srcs = [
        "hover.ts",
        "touch_mouse.ts",
    ],
    visibility = ["//:__subpackages__"],
    deps = ["//:node_modules/@types/node"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "hover.ts",
        "touch_mouse.ts",
        "touch_mouse_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

jest_test(
    name = "tests",
    srcs = ["touch_mouse_test.js"],
    jsdom = True,
    visibility = ["//:__subpackages__"],
    deps = [":pointer_tests"],
)

ts_project(
    name = "pointer_tests",
    srcs = ["touch_mouse_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":pointer",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
    ],
)
