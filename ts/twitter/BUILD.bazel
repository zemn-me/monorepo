load("//bzl:rules.bzl", "bazel_lint")
load("//jq:upgrade_json_schema.bzl", "upgrade_json_schema")
load("//js:rules.bzl", "js_binary", "js_run_binary")
load("//py:rules.bzl", "py_test")
load("//ts:rules.bzl", "ts_project")

package(default_visibility = ["//:__subpackages__"])

ts_project(
    name = "twitter",
    srcs = [
        "archive.ts",
        "json_schema.ts",
    ],
    deps = [
        "//:node_modules/zod",
    ],
)

js_binary(
    name = "json_schema_bin",
    data = [
        ":twitter",
    ],
    entry_point = "json_schema.js",
)

js_run_binary(
    name = "json_schema",
    stdout = "json_schema.json",
    tool = ":json_schema_bin",
)

# The type generator cannot decode tuple-valued items. Keep its existing
# projection separate from the schema used for validation.
upgrade_json_schema(
    name = "json_schema_go",
    src = ":json_schema",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

py_test(
    name = "json_schema_test",
    srcs = ["json_schema_test.py"],
    args = [
        "$(location //go/cmd/jsonschemavalidator)",
        "$(location :json_schema)",
    ],
    data = [
        ":json_schema",
        "//go/cmd/jsonschemavalidator",
    ],
    main = "json_schema_test.py",
)
