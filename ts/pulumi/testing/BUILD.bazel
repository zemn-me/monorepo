load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "testing",
    srcs = ["lambda_archives.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@pulumi/pulumi",
        "//:node_modules/@types/node",
        "//:node_modules/jszip",
    ],
)

jest_test(
    name = "tests",
    size = "large",
    srcs = [
        "lambda_archives_test.js",
        "pulumi_test.js",
        "retire_bowery_bugle_test.js",
        "retire_lulu_test.js",
    ],
    data = [
        "//ts/do-sync:npm_package",
        "//ts/do-sync:npm_pkg.publish",
        "//ts/do-sync:npm_pkg_version",
    ],
    visibility = ["//:__subpackages__"],
    deps = [":testing_tests"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "lambda_archives.ts",
        "lambda_archives_test.ts",
        "pulumi_test.ts",
        "retire_bowery_bugle_test.ts",
        "retire_lulu_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

ts_project(
    name = "testing_tests",
    srcs = [
        "lambda_archives_test.ts",
        "pulumi_test.ts",
        "retire_bowery_bugle_test.ts",
        "retire_lulu_test.ts",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":testing",
        "//:node_modules/@jest/globals",
        "//:node_modules/@pulumi/pulumi",
        "//:node_modules/@types/node",
        "//:node_modules/jszip",
        "//ts/pulumi",
        "//ts/pulumi/lib",
    ],
)
