load("@aspect_bazel_lib//lib:copy_file.bzl", "copy_file")
load("@rules_itest//private:itest.bzl", "itest_service", "itest_task", "service_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//bzl/aws_emulator:build.bzl", "emulator_binary")
load("//js:rules.bzl", "js_binary", "js_test")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "ts_project")

package(default_testonly = True)

js_binary(
    name = "service_bin",
    data = [
        ":emulator_binary",
        "//ts/pulumi/testing/emulator/runtime",
    ],
    entry_point = "//ts/pulumi/testing/emulator/runtime:service.js",
    env = {"EMULATOR_BINARY": "$(rlocationpath :emulator_binary)"},
)

itest_service(
    name = "service",
    autoassign_port = True,
    exe = ":service_bin",
    health_check = ":service_bin",
    health_check_args = ["--health"],
    health_check_interval = "200ms",
    health_check_timeout = "30s",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

js_binary(
    name = "gcp_fixture",
    data = ["//ts/pulumi/testing/emulator/runtime"],
    entry_point = "//ts/pulumi/testing/emulator/runtime:external_provider.js",
    env = {"FIXTURE_PROVIDER": "gcp"},
)

js_binary(
    name = "command_fixture",
    data = ["//ts/pulumi/testing/emulator/runtime"],
    entry_point = "//ts/pulumi/testing/emulator/runtime:external_provider.js",
    env = {"FIXTURE_PROVIDER": "command"},
)

[
    js_test(
        name = scenario + "_bin",
        size = "large",
        timeout = "long",
        data = [
            ":aws_provider",
            ":command_fixture",
            ":emulator",
            ":gcp_fixture",
            ":random_provider",
            "//go/aws_emulator_gateway",
        ],
        entry_point = "driver.js",
        env = {
            "EMULATOR_SCENARIO": scenario,
            "EMULATOR_GATEWAY": "$(rlocationpath //go/aws_emulator_gateway)",
            "PROVIDER_AWS": "$(rlocationpath :aws_provider)",
            "PROVIDER_RANDOM": "$(rlocationpath :random_provider)",
            "PROVIDER_GCP": "$(rlocationpath :gcp_fixture)",
            "PROVIDER_COMMAND": "$(rlocationpath :command_fixture)",
        },
        tags = ["manual"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
    )
    for scenario in [
        "staging",
        "production",
    ]
]

itest_task(
    name = "zemn_deployment",
    args = ["--zemn-features"],
    exe = ":staging_bin",
    visibility = ["//project/me/zemn/api:__subpackages__"],
    deps = [":service"],
)

[
    service_test(
        name = scenario + "_test",
        size = "large",
        timeout = "long",
        services = [":service"],
        target_compatible_with = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ],
        test = ":" + scenario + "_bin",
    )
    for scenario in [
        "staging",
        "production",
    ]
]

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

ts_project(
    name = "emulator",
    srcs = [
        "binary_function.ts",
        "driver.ts",
        "zemn.ts",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@pulumi/aws",
        "//:node_modules/@pulumi/command",  # keep: runtime fixture provider metadata
        "//:node_modules/@pulumi/gcp",  # keep: runtime fixture provider metadata
        "//:node_modules/@pulumi/pulumi",
        "//:node_modules/@pulumi/random",  # keep: runtime provider metadata
        "//:node_modules/@types/node",
        "//ts/pulumi",
        "//ts/pulumi:cli",
        "//ts/pulumi/lib",
        "//ts/pulumi/testing/emulator/runtime",
        "//ts/pulumi/zemn.me/api",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "binary_function.ts",
        "driver.ts",
        "zemn.ts",
    ],
    visibility = ["//:__subpackages__"],
)

emulator_binary(
    name = "emulator_binary",
    src = "@aws_emulator_linux_amd64//:source.tar.gz",
    out = "aws-emulator",
    crates = "@aws_emulator_linux_amd64//:crates",
    patch = "//bzl/aws_emulator:regional_origin.patch",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

copy_file(
    name = "aws_provider",
    src = "@pulumi_aws_provider_linux_amd64//:pulumi-resource-aws",
    out = "pulumi-resource-aws",
    is_executable = True,
)

copy_file(
    name = "random_provider",
    src = "@pulumi_random_provider_linux_amd64//:pulumi-resource-random",
    out = "pulumi-resource-random",
    is_executable = True,
)

md_files(
    name = "md",
    srcs = ["README.md"],
    refs = ["//bzl/aws_emulator:regional_origin.patch"],
    visibility = ["//:__subpackages__"],
)
