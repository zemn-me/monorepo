load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "jest_test", "ts_project")

exports_files(["security.txt"])

ts_project(
    name = "website",
    srcs = [
        "remix.ts",
        "website.ts",
    ],
    data = ["security.txt"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@pulumi/aws",
        "//:node_modules/@pulumi/pulumi",
        "//:node_modules/@pulumi/random",
        "//:node_modules/@types/mime",
        "//:node_modules/@types/node",
        "//:node_modules/file-type",
        "//:node_modules/mime",
        "//ts",
        "//ts/pulumi/lib",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "remix.ts",
        "website.ts",
        "website_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "website_tests",
    srcs = ["website_test.ts"],
