load("//bzl:rules.bzl", "bazel_lint")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "ts_project")

ts_project(
    name = "app",
    srcs = [
        "layout.tsx",
        "page.tsx",
        "temple_background.tsx",
        "temple_church.ts",
    ],
    assets = ["style.css"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/next",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//ts/3d",
        "//ts/math",
        "//ts/next.js",
        "//ts/next.js/types/next-compiled",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "layout.tsx",
        "page.tsx",
        "temple_background.tsx",
        "temple_church.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

md_files(
    name = "md",
    srcs = ["temple_church.md"],
    visibility = ["//:__subpackages__"],
)
