load("//bzl:rules.bzl", "bazel_lint")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "ts_project")

ts_project(
    name = "app",
    srcs = [
        "hangar.ts",
        "hangar_background.tsx",
        "not-found.tsx",
        "page.tsx",
        "root.tsx",
        "routes.ts",
    ],
    assets = ["style.css"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@react-router/dev",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
        "//ts/3d",
        "//ts/math",
        "//ts/pulumi/waxingincandescent.com/hangar",
        "//ts/remix",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "hangar.ts",
        "hangar_background.tsx",
        "not-found.tsx",
        "page.tsx",
        "root.tsx",
        "routes.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

md_files(
    name = "md",
    srcs = ["hangar.md"],
    visibility = ["//:__subpackages__"],
)
