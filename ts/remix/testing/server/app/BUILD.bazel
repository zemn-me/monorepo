load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "ts_project")

ts_project(
    name = "app",
    srcs = [
        "index.tsx",
        "live.tsx",
        "root.tsx",
        "routes.ts",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@react-router/dev",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "index.tsx",
        "live.tsx",
        "root.tsx",
        "routes.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)
