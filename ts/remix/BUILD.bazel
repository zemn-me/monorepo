load("//bzl:rules.bzl", "bazel_lint")

# gazelle:exclude server_test.mjs
load("//js:rules.bzl", "copy_to_bin", "js_library", "js_test")
load("//ts:rules.bzl", "jest_test", "ts_project")

# The JS generator cannot resolve the runner/runtime import within a grouped target.
# gazelle:exclude runner.mjs
# gazelle:exclude server.mjs

package(default_visibility = ["//:__subpackages__"])

ts_project(
    name = "remix",
    srcs = [
        "error.tsx",
        "index.tsx",
        "metadata.tsx",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
        "//ts/trusted_types",
    ],
)

js_library(
    name = "tooling",
    srcs = ["vite.mjs"],

    # keep
    data = [
        ":runner",
        ":server",
        "//:node_modules/esbuild",
        "//:node_modules/react-router",
        "//:node_modules/serve-handler",
    ],
    deps = [
        "//:node_modules/@react-router/dev",
        "//:node_modules/vite",
    ],
)

copy_to_bin(
    name = "runner",
    srcs = ["runner.mjs"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = [
        "BUILD.bazel",
        "image_srcset.bzl",
        "public_assets.bzl",
        "rules.bzl",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "error.tsx",
        "index.tsx",
        "metadata.tsx",
        "metadata_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "remix_tests",
    srcs = ["metadata_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":remix",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
    ],
)

jest_test(
    name = "tests",
    srcs = ["metadata_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":remix_tests"],
)

copy_to_bin(
    name = "server",
    srcs = ["server.mjs"],
)

js_test(
    name = "server_test",
    size = "small",
    data = [":tooling"],
    entry_point = "server_test.mjs",
)
