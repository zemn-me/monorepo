load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "schema.org",
    srcs = ["schema.tsx"],
    visibility = ["//:__subpackages__"],
    deps = [
        "//:base_defs",  #keep
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/schema-dts",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "schema.tsx",
        "schema_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "schema.org_tests",
    srcs = ["schema_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":schema.org",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/react",
        "//:node_modules/react-dom",
    ],
)

jest_test(
    name = "tests",
    srcs = ["schema_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":schema.org_tests"],
)
