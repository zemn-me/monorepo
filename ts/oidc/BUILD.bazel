load("//bzl:rules.bzl", "bazel_lint")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "oidc",
    srcs = [
        "authentication_request.ts",
        "authentication_response.ts",
        "callback_params.ts",
        "configuration.ts",
        "id_token.ts",
        "login_hint.ts",
        "oidc.ts",
        "state.ts",
        "validate_authentication_request.ts",
    ],
    visibility = [
        "//:__subpackages__",
    ],
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/base64-js",
        "//:node_modules/jose",
        "//:node_modules/zod",
        "//ts/option",
        "//ts/result",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
    visibility = ["//:__subpackages__"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "authentication_request.ts",
        "authentication_response.ts",
        "callback_params.ts",
        "configuration.ts",
        "id_token.ts",
        "login_hint.ts",
        "login_hint_test.ts",
        "oidc.ts",
        "state.ts",
        "validate_authentication_request.ts",
    ],
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "oidc_tests",
    srcs = ["login_hint_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":oidc",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
    ],
)

jest_test(
    name = "tests",
    srcs = ["login_hint_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":oidc_tests"],
)
