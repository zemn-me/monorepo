load("//bzl:rules.bzl", "bazel_lint")
load("//js/npm:rules.bzl", "npm_pkg")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "future",
    srcs = ["future.ts"],
    regenerator_runtime = False,
    visibility = ["//:__subpackages__"],
    deps = [
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
    ],
)

npm_pkg(
    name = "npm_pkg",
    srcs = [":future"],
    entry_point = "future.ts",
    major_version = "version/major",
    minor_version = "version/minor",
    patch_version = "version/patch",
    pkg_json_base = "package.template.json",
    readme = "README.md",
    release_lock = ".release.lock",
    test_version_on_main = True,
    tgz = "npm_package",
    visibility = [
        "//ci:__subpackages__",
        "//ts/pulumi:__subpackages__",
    ],
)

jest_test(
    name = "tests",
    srcs = ["future_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":future_tests"],
)

ts_project(
    name = "future_tests",
    srcs = ["future_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":future",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "future.ts",
        "future_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

md_files(
    name = "ts_future",
    srcs = ["README.md"],
    visibility = ["//:__subpackages__"],
)
