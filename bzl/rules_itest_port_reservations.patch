 }
+
+func openReservationSocket() (syscall.Handle, error) {
+	fd, err := syscall.Socket(syscall.AF_INET, syscall.SOCK_STREAM, syscall.IPPROTO_TCP)
+	if err != nil {
+		return fd, err
+	}
+	syscall.CloseOnExec(fd)
+	// Winsock defines SO_EXCLUSIVEADDRUSE as the complement of SO_REUSEADDR.
+	if err := syscall.SetsockoptInt(fd, syscall.SOL_SOCKET, ^syscall.SO_REUSEADDR, 1); err != nil {
+		syscall.Closesocket(fd)
+		return syscall.InvalidHandle, err
+	}
+	return fd, nil
+}
+
+func closeReservationSocket(fd syscall.Handle) error { return syscall.Closesocket(fd) }
