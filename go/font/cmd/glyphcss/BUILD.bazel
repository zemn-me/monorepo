load("//bzl:rules.bzl", "bazel_lint")
load("//go:rules.bzl", "go_binary", "go_library")

go_library(
    name = "glyphcss_lib",
    srcs = ["main.go"],
    importpath = "github.com/zemn-me/monorepo/go/font/cmd/glyphcss",
    visibility = ["//visibility:private"],
    deps = [
        "@org_golang_x_image//font/sfnt",
        "@org_golang_x_image//math/fixed",
    ],
)

go_binary(
    name = "glyphcss",
    embed = [":glyphcss_lib"],
    visibility = ["//visibility:public"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)
