load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//go:rules.bzl", "go_library")
load("//js:rules.bzl", "js_binary", "js_library", "js_run_binary")

"""
Provides the rlocationpath of chromewebdriver to TypeScript
"""

genrule(
    name = "chromedriver_rlocation_gen",
    srcs = [
        "//bin/host/chromedriver",
    ],
    outs = ["chromedriver_rlocation.go"],
    cmd_bash = """
		echo "package selenium" >> $@
		echo "const chromeDriverRlocationPath = \\`$(rlocationpath //bin/host/chromedriver)\\`" >> $@
	""",
)

genrule(
    name = "chromium_rlocation_gen",
    srcs = [
        "//bin/host/chromium",
    ],
    outs = ["chrome_rlocation.go"],
    cmd_bash = """
		echo "package selenium" >> $@
		p=$(rlocationpath //bin/host/chromium)
		p=$${p#\\'}
		p=$${p%\\'}
		echo "const chromiumRlocationPath = \\`$${p}\\`" >> $@
	""",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

go_library(
    name = "seleniumutil",
    srcs = [
        "chrome_rlocation.go",
        "chromedriver_rlocation.go",
        "console.go",
        "navigation.go",
        "page_commands.go",
        "selenium.go",
        "virtual_clock.go",
    ],
    data = [
        "//bin/host/chromedriver",
        "//bin/host/chromium",
    ],
    # Gazelle cannot infer a go:embed input generated by js_run_binary.
    embedsrcs = [":virtual_clock_bundle"],  # keep
    importpath = "github.com/zemn-me/monorepo/go/seleniumutil",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_gorilla_websocket//:websocket",
        "@com_github_tebeka_selenium//:selenium",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

go_test(
    name = "seleniumutil_test",
    srcs = [
        "console_test.go",
        "navigation_browser_test.go",
        "navigation_test.go",
        "page_commands_test.go",
        "selenium_test.go",
        "virtual_clock_test.go",
    ],
    embed = [":seleniumutil"],
    deps = ["@com_github_tebeka_selenium//:selenium"],
)

js_library(
    name = "virtual_clock_source",
    srcs = ["virtual_clock.mjs"],
    deps = ["//:node_modules/@sinonjs/fake-timers"],
)

js_library(
    name = "bundle_virtual_clock_source",
    srcs = ["bundle_virtual_clock.mjs"],
    # esbuild resolves this entry point at runtime.
    data = [":virtual_clock_source"],  # keep
    deps = ["//:node_modules/esbuild"],
)

js_binary(
    name = "bundle_virtual_clock_bin",
    data = [":bundle_virtual_clock_source"],
    entry_point = "bundle_virtual_clock.mjs",
)

js_run_binary(
    name = "virtual_clock_bundle",
    stdout = "virtual_clock_bundle.js",
    tool = ":bundle_virtual_clock_bin",
)
