load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_itest//private:itest.bzl", "itest_service", "service_test")
load("//bzl:rules.bzl", "bazel_lint")

package(default_visibility = ["//:__subpackages__"])

itest_service(
    name = "site",
    args = [
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    exe = "//project/me/zemn:start",
    health_check_timeout = "180s",
    http_health_check_address = "http://localhost:$${PORT}/experiments/tiberian-sun",
)

service_test(
    name = "integration_test",
    size = "large",
    # Emit timings as commands finish: a process timeout loses Go's buffered logs.
    args = ["-test.v"],
    # Two complete engines use software-rendered Chromium alongside the site.
    # Reserve their CPU and memory rather than relying on an estimate from the
    # much lighter browser scenarios sharing this test target.
    exec_properties = {
        "test.EstimatedCPU": "4",
        "test.EstimatedMemory": "4GB",
        # WebRTC needs a browser-visible interface to gather ICE candidates.
        "test.network": "external",
    },
    services = [":site"],
    # Keep each browser scenario within the test deadline under remote contention.
    shard_count = 4,
    test = ":testing_test",
)

go_test(
    name = "testing_test",
    srcs = [
        "background_test.go",
        "browser_helpers_test.go",
        "browser_test.go",
        "game_browser_test.go",
        "multiplayer_browser_test.go",
        "multiplayer_test.go",
    ],
    tags = ["manual"],  # keep; requires the production site service.
    deps = [
        "//go/seleniumutil",
        "@com_github_tebeka_selenium//:selenium",
        "@com_github_tebeka_selenium//log",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)
