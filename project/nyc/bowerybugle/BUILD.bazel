load("@rules_itest//private:itest.bzl", "itest_service")
load("//md:rules.bzl", "md_files")

# gazelle:resolve typescript typescript #root/project/nyc/bowerybugle/api/api_client.gen.js //project/nyc/bowerybugle/api:ts_client_dts

load("//bzl:rules.bzl", "bazel_lint")
load("//js:rules.bzl", "js_binary", "js_library")
load("//ts/remix:rules.bzl", "remix_project")

package(default_visibility = ["//:__subpackages__"])

remix_project(
    name = "remix",
    srcs = ["//project/nyc/bowerybugle/app"],
    server_entry = "renderer.mjs",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

js_library(
    name = "react-router_config_mjs",
    srcs = ["react-router.config.mjs"],
    deps = [],
)

js_library(
    name = "vite_config_mjs",
    srcs = ["vite.config.mjs"],
    deps = ["@monorepo//ts/remix:tooling"],
)

md_files(
    name = "md",
    srcs = ["AGENTS.md"],
    visibility = ["//:__subpackages__"],
)

js_binary(
    name = "renderer_test_bin",
    data = [":build"],
    entry_point = "renderer_test_service.mjs",
)

itest_service(
    name = "renderer_test_service",
    args = [
        "--port",
        "$${PORT}",
    ],
    autoassign_port = True,
    exe = ":renderer_test_bin",
    http_health_check_address = "http://127.0.0.1:$${PORT}/health",
)
