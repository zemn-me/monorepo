load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//bzl:rules.bzl", "bazel_lint")
load("//go:rules.bzl", "go_binary", "go_library")
load("//ts/pulumi/lib/oci:rules.bzl", "pulumi_image")

go_library(
    name = "api_lib",
    srcs = ["main.go"],
    importpath = "github.com/zemn-me/monorepo/project/nyc/bowerybugle/cmd/api",
    visibility = ["//visibility:private"],
    deps = [
        "//project/nyc/bowerybugle/server",
        "@com_github_aws_aws_lambda_go//lambda",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//:dynamodb",
        "@com_github_aws_aws_sdk_go_v2_service_s3//:s3",
        "@com_github_aws_aws_sdk_go_v2_service_sesv2//:sesv2",
        "@com_github_awslabs_aws_lambda_go_api_proxy//httpadapter",
    ],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    goarch = "amd64",
    goos = "linux",
    pure = "on",
    visibility = ["//visibility:public"],
)

pkg_tar(
    name = "tar",
    srcs = [":api"],
)

oci_image(
    name = "image",
    base = "@distroless_debian12",
    entrypoint = ["/api"],
    tars = [":tar"],
)

pulumi_image(
    name = "oci_image",
    src = ":image",
    component_name = "BoweryBugleImage",
    visibility = ["//ts/pulumi/bowerybugle.nyc:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)
