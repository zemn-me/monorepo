load("//bzl:rules.bzl", "bazel_lint")
load("//css/module:rules.bzl", "css_module")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "analytics",
    srcs = [
        "client.tsx",
        "page.tsx",
        "report.ts",
        "useReport.ts",
    ],
    assets = ["style.module.css"],
    visibility = [
        "//project/me/zemn:__subpackages__",
    ],
    deps = [
        ":style_module_css",
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//project/me/zemn/api:ts_client_dts",
        "//project/me/zemn/components/Link",
        "//project/me/zemn/hook",
        "//ts",
        "//ts/future",
        "//ts/oidc",
        "//ts/option",
    ],
