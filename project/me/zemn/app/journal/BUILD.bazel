load("//bzl:rules.bzl", "bazel_lint")
load("//css/module:rules.bzl", "css_module")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "journal",
    srcs = [
        "client.tsx",
        "layout.tsx",
        "location_geometry.ts",
        "location_map.tsx",
        "mcp_setup.tsx",
        "page.tsx",
        "periods.ts",
        "recording.ts",
        "recording_queue.tsx",
        "recording_store.ts",
        "status.tsx",
    ],
    assets = ["style.module.css"],
    visibility = ["//project/me/zemn:__subpackages__"],
    deps = [
        ":location_map_module_css",
        ":style_module_css",
        "//:node_modules/@fortawesome/free-solid-svg-icons",
        "//:node_modules/@fortawesome/react-fontawesome",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/@types/react-dom",
        "//:node_modules/next",
        "//:node_modules/nuqs",
        "//:node_modules/react",
        "//:node_modules/react-dom",
        "//:node_modules/react-markdown",
        "//:node_modules/temporal-polyfill",
        "//project/me/zemn/api:ts_client_dts",
        "//project/me/zemn/components/FootnotePreviews",
        "//project/me/zemn/components/Link",
        "//project/me/zemn/constants",
        "//project/me/zemn/hook",
        "//ts/next.js/types/next-compiled",
        "//ts/oidc",
        "//ts/react/lang",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "client.tsx",
        "layout.tsx",
        "location_geometry.ts",
        "location_geometry_test.ts",
        "location_map.tsx",
        "mcp_setup.tsx",
        "page.tsx",
        "periods.ts",
        "periods_test.ts",
        "recording.ts",
        "recording_queue.tsx",
        "recording_store.ts",
        "recording_test.ts",
        "status.tsx",
    ],
    visibility = ["//:__subpackages__"],
)

css_module(
    name = "style_module_css",
    src = "style.module.css",
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "journal_tests",
    srcs = [
        "location_geometry_test.ts",
        "periods_test.ts",
        "recording_test.ts",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        ":journal",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
    ],
)

jest_test(
    name = "tests",
    srcs = [
        "location_geometry_test.js",
        "periods_test.js",
        "recording_test.js",
    ],
    jsdom = True,
    visibility = ["//:__subpackages__"],
    deps = [":journal_tests"],
)

md_files(
    name = "md",
    srcs = ["AGENTS.md"],
    visibility = ["//:__subpackages__"],
)

css_module(
    name = "location_map_module_css",
    src = "location_map.module.css",
    visibility = ["//:__subpackages__"],
)
