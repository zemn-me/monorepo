load("//bzl:rules.bzl", "bazel_lint")
load("//css/module:rules.bzl", "css_module")
load("//ts:rules.bzl", "ts_project")
load("//ts/remix:public_assets.bzl", "hashed_public_assets")

hashed_public_assets(
    name = "runtime",
    outs = ["assets.ts"],
    assets = {
        "//project/vanilla_conquer/web:ra_javascript": "raJavaScript",
        "//project/vanilla_conquer/web:ra_wasm": "raWasm",
        "//project/vanilla_conquer/web:td_javascript": "tdJavaScript",
        "//project/vanilla_conquer/web:td_wasm": "tdWasm",
        "//project/vanilla_conquer/assets:ra_data": "raData",
        "//project/vanilla_conquer/assets:td_data": "tdData",
        "//project/vanilla_conquer:License.txt": "license",
        "//project/vanilla_conquer/assets:ra_notice": "raNotice",
        "//project/vanilla_conquer/assets:td_notice": "tdNotice",
        "@vanilla_sdl2//:LICENSE.txt": "sdlLicense",
    },
    public_dir = "sha256",
)

ts_project(
    name = "vanilla_conquer",
    srcs = [
        "client.tsx",
        "command_and_conquer.tsx",
        "red_alert.tsx",
        ":runtime_generated",
    ],
    assets = ["style.module.css"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":style_module_css",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
        "//project/me/zemn/components/Link",
        "//project/vanilla_conquer/web",
        "//ts/future",
        "//ts/remix",
    ],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "client.tsx",
        "command_and_conquer.tsx",
        "red_alert.tsx",
    ],
    visibility = ["//:__subpackages__"],
)

css_module(
    name = "style_module_css",
    src = "style.module.css",
    visibility = ["//:__subpackages__"],
)
