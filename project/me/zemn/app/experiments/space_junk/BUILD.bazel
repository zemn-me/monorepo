load("//bzl:rules.bzl", "bazel_lint")
load("//css/module:rules.bzl", "css_module")
load("//ts:rules.bzl", "jest_test", "ts_project")
load("//ts/remix:public_assets.bzl", "hashed_public_assets")

genrule(
    name = "catalogue",
    srcs = ["@gcat_standard_catalog//file"],
    outs = ["catalogue.json"],
    cmd = "$(execpath //project/me/zemn/app/experiments/space_junk/importer:catalogue) $(location @gcat_standard_catalog//file) $@",
    tools = ["//project/me/zemn/app/experiments/space_junk/importer:catalogue"],
)

hashed_public_assets(
    name = "catalogue_assets",
    outs = ["assets.ts"],
    assets = {":catalogue": "catalogueUrl"},
    public_dir = "sha256",
)

ts_project(
    name = "space_junk",
    srcs = [
        "chart.ts",
        "elements.ts",
        "orbit.ts",
        "page.tsx",
        "sky.tsx",
        "wheel.tsx",
        ":catalogue_assets_generated",
    ],
    assets = ["style.module.css"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":style_module_css",
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//:node_modules/react-router",
        "//:node_modules/satellite.js",
        "//:node_modules/temporal-polyfill",
        "//ts/remix",
    ],
)

css_module(
    name = "style_module_css",
    src = "style.module.css",
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "chart.ts",
        "chart_test.ts",
        "elements.ts",
        "orbit.ts",
        "page.tsx",
        "sky.tsx",
        "wheel.tsx",
    ],
    visibility = ["//:__subpackages__"],
)

ts_project(
    name = "space_junk_tests",
    srcs = ["chart_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":space_junk",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
        "//:node_modules/temporal-polyfill",
    ],
)

jest_test(
    name = "tests",
    srcs = ["chart_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":space_junk_tests"],
)
