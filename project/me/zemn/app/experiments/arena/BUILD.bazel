# gazelle:resolve typescript #root/project/me/zemn/app/experiments/arena/level.js //project/me/zemn/app/experiments/arena:arena
load("//bzl:rules.bzl", "bazel_lint")
load("//css/module:rules.bzl", "css_module")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "jest_test", "ts_project")

ts_project(
    name = "arena",
    srcs = [
        "client.tsx",
        "page.tsx",
        "scene.ts",
        ":level",
    ],
    assets = glob(
        [
            "**/*.css",
            "**/*.svg",
        ],
        allow_empty = True,
    ),
    visibility = ["//:__subpackages__"],
    deps = [
        ":style_module_css",
        "//:node_modules/@types/node",
        "//:node_modules/@types/react",
        "//:node_modules/react",
        "//ts/3d",
        "//ts/doom",
        "//ts/math",
        "//ts/remix",
    ],
)

ts_project(
    name = "arena_tests",
    srcs = ["scene_test.ts"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":arena",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/node",
        "//ts/math",
        "//ts/result",
    ],
)

jest_test(
    name = "tests",
    srcs = ["scene_test.js"],
    visibility = ["//:__subpackages__"],
    deps = [":arena_tests"],
)

filegroup(
    name = "all_ts_srcs",
    srcs = [
        "client.tsx",
        "page.tsx",
        "scene.ts",
        "scene_test.ts",
    ],
    visibility = ["//:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

css_module(
    name = "style_module_css",
    src = "style.module.css",
    visibility = ["//:__subpackages__"],
)

genrule(
    name = "level",
    srcs = ["@doom_shareware//file"],
    outs = ["level.ts"],
    cmd = "$(execpath //py/doom:doom_bin) --archive $(location @doom_shareware//file) --output $@",
    tools = ["//py/doom:doom_bin"],
)

md_files(
    name = "md",
    srcs = ["AGENTS.md"],
    visibility = ["//:__subpackages__"],
)
