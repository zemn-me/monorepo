load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("@rules_itest//private:itest.bzl", "itest_service", "service_test")
load("//bzl:rules.bzl", "bazel_lint")

# gazelle:exclude server_test.mjs
load("//js:rules.bzl", "js_test")
load("//md:rules.bzl", "md_files")
load("//ts:rules.bzl", "jest_test", "ts_project")

# Browser binaries are grouped by surface and share test helpers explicitly.
# gazelle:exclude admin_test.go
# gazelle:exclude analytics_test.go
# gazelle:exclude go_basic_test.go
# gazelle:exclude grievance_portal_test.go
# gazelle:exclude integration_helpers_test.go
# gazelle:exclude journal_pagination_test.go
# gazelle:exclude journal_oauth_test.go
# gazelle:exclude journal_ssr_test.go
# gazelle:exclude journal_test.go
# gazelle:exclude journal_wiki_test.go
