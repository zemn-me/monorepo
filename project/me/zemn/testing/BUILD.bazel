package(default_visibility = ["//visibility:public"])

test_suite(
    name = "integration_test",
    tests = [
        ":admin_integration_test",
        ":journal_access_integration_test",
        ":journal_integration_test",
        ":site_integration_test",
    ],
)

service_test(
    name = "journal_integration_test",
    size = "large",  # Each isolated production frontend builds after port assignment.
    flaky = True,
    services = [
        "//project/me/zemn:itest_service_calendar_fixture",
        ":oidc_provider_itest_service",
    ],
    test = ":journal_browser_test",
)

service_test(
    name = "journal_access_integration_test",
    size = "large",  # Each isolated production frontend builds after port assignment.
    flaky = True,
    services = [
        "//project/me/zemn:itest_service_calendar_fixture",
        ":oidc_provider_itest_service",
    ],
    test = ":journal_access_browser_test",
)

service_test(
    name = "admin_integration_test",
    size = "large",  # Each isolated production frontend builds after port assignment.
    flaky = True,
    services = [
        "//project/me/zemn:itest_service_calendar_fixture",
        ":oidc_provider_itest_service",
    ],
    test = ":admin_browser_test",
)

service_test(
    name = "site_integration_test",
    size = "large",  # Each isolated production frontend builds after port assignment.
    flaky = True,
    services = [
        "//project/me/zemn:itest_service_calendar_fixture",
        ":oidc_provider_itest_service",
    ],
    test = ":site_browser_test",
)

itest_service(
    name = "oidc_provider_itest_service",
    args = [
        "--port",
        ":$${PORT}",
    ],
    autoassign_port = True,
    exe = "//project/me/zemn/testing/cmd/oidc_provider:oidc_provider",
    http_health_check_address = "http://localhost:$${PORT}/.well-known/openid-configuration",
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

ts_project(
    name = "ts",
    srcs = ["browser_test.ts"],
    data = [
        "//project/me/zemn:build",
    ],
    deps = [
        "//:node_modules/@bazel/runfiles",
        "//:node_modules/@jest/globals",
        "//:node_modules/@types/jest",
        "//:node_modules/@types/node",
        "//:node_modules/@types/selenium-webdriver",
        "//:node_modules/@types/serve-handler",
        "//:node_modules/fast-glob",
        "//:node_modules/jose",
        "//:node_modules/selenium-webdriver",
        "//:node_modules/serve-handler",
        "//ts/selenium",
    ],
)

jest_test(
    name = "testing",
    size = "medium",
    srcs = ["browser_test.js"],
    data = [
        ":ts",
        "//project/me/zemn/api/cmd/localserver",
        "//ts/oidc",
    ],
)

go_test(
    name = "journal_browser_test",
    srcs = [
        "integration_helpers_test.go",
        "journal_test.go",
        "navigation_helpers_test.go",
    ],
    tags = ["manual"],  # Needs the integration service harness.
    deps = [
        "//go/seleniumutil",
        "//project/me/zemn/api/server",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_credentials//:credentials",
        "@com_github_aws_aws_sdk_go_v2_feature_dynamodb_attributevalue//:attributevalue",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//:dynamodb",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//types",
        "@com_github_tebeka_selenium//:selenium",
        "@com_github_tebeka_selenium//log",
    ],
)

go_test(
    name = "journal_access_browser_test",
    srcs = [
        "integration_helpers_test.go",
        "journal_oauth_test.go",
        "journal_pagination_test.go",
        "journal_ssr_test.go",
        "journal_wiki_test.go",
        "navigation_helpers_test.go",
    ],
    tags = ["manual"],  # Needs the integration service harness.
    deps = [
        "//go/seleniumutil",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
        "@com_github_tebeka_selenium//:selenium",
        "@com_github_tebeka_selenium//log",
    ],
)

go_test(
    name = "admin_browser_test",
    srcs = [
        "admin_test.go",
        "analytics_test.go",
        "integration_helpers_test.go",
        "navigation_helpers_test.go",
    ],
    tags = ["manual"],  # Needs the integration service harness.
    deps = [
        "//go/seleniumutil",
        "//project/me/zemn/testing/oidc",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_credentials//:credentials",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//:dynamodb",
        "@com_github_aws_aws_sdk_go_v2_service_dynamodb//types",
        "@com_github_tebeka_selenium//:selenium",
        "@com_github_tebeka_selenium//log",
    ],
)

go_test(
    name = "site_browser_test",
    srcs = [
        "go_basic_test.go",
        "grievance_portal_test.go",
        "integration_helpers_test.go",
        "key_test.go",
        "navigation_helpers_test.go",
    ],
    tags = ["manual"],  # Needs the integration service harness.
    deps = [
        "//go/seleniumutil",
        "@com_github_tebeka_selenium//:selenium",
        "@com_github_tebeka_selenium//log",
    ],
)

filegroup(
    name = "all_ts_srcs",
    srcs = ["browser_test.ts"],
    visibility = ["//:__subpackages__"],
)

md_files(
    name = "project_me_zemn_testing",
    srcs = ["AGENTS.md"],
    visibility = ["//:__subpackages__"],
)

js_test(
    name = "server_test",
    size = "small",
    data = [
        "//project/me/zemn:build",
        "//project/me/zemn/app/experiments/tiberian_sun",
    ],
    entry_point = "server_test.mjs",
)
