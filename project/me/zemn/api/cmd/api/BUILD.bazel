load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//go:rules.bzl", "go_binary", "go_library")
load("//ts/pulumi/lib/oci:rules.bzl", "pulumi_binary_image")

package(default_visibility = ["//ts/pulumi/zemn.me/api:__subpackages__"])

go_library(
    name = "api_lib",
    srcs = ["main.go"],
    importpath = "github.com/zemn-me/monorepo/project/me/zemn/api/cmd/api",
    visibility = ["//visibility:private"],
    deps = [
        "//project/me/zemn/api/server",
        "@com_github_aws_aws_lambda_go//lambda",
        "@com_github_awslabs_aws_lambda_go_api_proxy//httpadapter",
    ],
)

pulumi_binary_image(
    name = "oci_image",
    srcs = [":api"],
    base = "@distroless_debian12",
    component_name = "ApiZemnMeLambdaImage",
    image_name = "image",
    visibility = ["//ts/pulumi/zemn.me/api:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

go_binary(
    name = "api",
    embed = [":api_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "api_test",
    srcs = ["smoke_test.go"],
    embed = [":api_lib"],
)
