load("@io_bazel_rules_go//go:def.bzl", "go_test")
load("//bzl:rules.bzl", "bazel_lint")
load("//go:rules.bzl", "go_binary", "go_library")
load("//py:rules.bzl", "py_test")
load("//ts/pulumi/lib/oci:rules.bzl", "pulumi_binary_image")

package(default_visibility = ["//ts/pulumi/zemn.me/api:__subpackages__"])

go_library(
    name = "journal_worker_lib",
    srcs = ["main.go"],
    importpath = "github.com/zemn-me/monorepo/project/me/zemn/api/cmd/journal_worker",
    visibility = ["//visibility:private"],
    deps = [
        "//project/me/zemn/api/server",
        "@com_github_aws_aws_lambda_go//events",
        "@com_github_aws_aws_lambda_go//lambda",
    ],
)

go_binary(
    name = "journal_worker",
    embed = [":journal_worker_lib"],
    visibility = ["//visibility:public"],
)

pulumi_binary_image(
    name = "oci_image",
    base = "@distroless_cc_debian12",
    binary = ":journal_worker",
    component_name = "JournalWorkerLambdaImage",
    image_name = "image",
    tools = ["//bin/host/ffmpeg"],
    visibility = ["//ts/pulumi/zemn.me/api:__subpackages__"],
)

bazel_lint(
    name = "bazel_lint",
    srcs = ["BUILD.bazel"],
)

go_test(
    name = "journal_worker_test",
    srcs = ["main_test.go"],
    embed = [":journal_worker_lib"],
)

py_test(
    name = "image_test",
    srcs = ["image_test.py"],
    args = [
        "$(rootpath :image)",
        "$(rootpath :journal_worker)",
        "$(rootpath //bin/host/ffmpeg)",
    ],
    data = [
        ":image",
        ":journal_worker",
        "//bin/host/ffmpeg",
    ],
)
